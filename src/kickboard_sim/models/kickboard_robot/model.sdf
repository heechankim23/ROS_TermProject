<?xml version="1.0"?>
<!-- 킥보드 수거 로봇 (Gazebo Harmonic / gz sim 8).
     앞: 운전석(캡) + 캡 위 로봇팔,  뒤: 킥보드 4대를 세워 싣는 적재함.
     전체 1.70 x 0.89 m (팔 접은 상태), 차동 구동 (바퀴 반지름 0.10, 간격 0.82), 앞·뒤 캐스터.

     좌표: 모델 원점 = 구동축 중심 아래 바닥 = base_footprint (DiffDrive odom 이 이 점의 pose), +x = 앞.
       차체   x -0.85 ~ +0.75,  y ±0.37,  z 0.08 ~ 0.30
       캡     x +0.35 ~ +0.75,  z 0.30 ~ 0.80
       적재함 x -0.85 ~ +0.33,  바닥 윗면 z 0.31.  칸 중심 x = -0.58, -0.36, -0.14, +0.08 (뒤 칸부터 채움)
       팔     회전축 (0.50, 0, 0.80), 어깨 (0.50, 0, 0.95), 윗팔 0.75, 아랫팔 0.75, 손목 -> 집게 중심 0.20
     arm_loader.py 의 상수(ARM_*, SLOT_*)와 반드시 같이 고칠 것.
     팔 링크는 충돌체가 없다 (보이기만 함 — 킥보드·바닥과 부딪혀 로봇이 밀리지 않게). -->
<sdf version="1.9">
  <model name="kickboard_robot">
    <link name="base_link">
      <inertial>
        <pose>-0.05 0 0.30 0 0 0</pose>
        <mass>60</mass>
        <inertia><ixx>4.0</ixx><iyy>14.0</iyy><izz>15.5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="chassis_collision">
        <pose>-0.05 0 0.19 0 0 0</pose>
        <geometry><box><size>1.60 0.74 0.22</size></box></geometry>
      </collision>
      <collision name="cab_collision">
        <pose>0.55 0 0.55 0 0 0</pose>
        <geometry><box><size>0.40 0.74 0.50</size></box></geometry>
      </collision>
      <collision name="caster_front_collision">
        <pose>0.62 0 0.04 0 0 0</pose>
        <geometry><sphere><radius>0.04</radius></sphere></geometry>
        <surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
      </collision>
      <collision name="caster_rear_collision">
        <pose>-0.72 0 0.04 0 0 0</pose>
        <geometry><sphere><radius>0.04</radius></sphere></geometry>
        <surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
      </collision>

      <visual name="chassis">
        <pose>-0.05 0 0.19 0 0 0</pose>
        <geometry><box><size>1.60 0.74 0.22</size></box></geometry>
        <material><ambient>0.22 0.24 0.28 1</ambient><diffuse>0.22 0.24 0.28 1</diffuse></material>
      </visual>
      <visual name="bumper">
        <pose>0.77 0 0.12 0 0 0</pose>
        <geometry><box><size>0.04 0.76 0.06</size></box></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
      <visual name="cab">
        <pose>0.55 0 0.55 0 0 0</pose>
        <geometry><box><size>0.40 0.74 0.50</size></box></geometry>
        <material><ambient>0.92 0.92 0.95 1</ambient><diffuse>0.92 0.92 0.95 1</diffuse></material>
      </visual>
      <visual name="cab_window">
        <pose>0.752 0 0.64 0 0 0</pose>
        <geometry><box><size>0.004 0.62 0.20</size></box></geometry>
        <material><ambient>0.15 0.3 0.45 1</ambient><diffuse>0.15 0.3 0.45 1</diffuse></material>
      </visual>
      <visual name="cab_stripe">
        <pose>0.55 0 0.40 0 0 0</pose>
        <geometry><box><size>0.404 0.744 0.05</size></box></geometry>
        <material><ambient>0.1 0.55 0.3 1</ambient><diffuse>0.1 0.55 0.3 1</diffuse></material>
      </visual>
      <visual name="headlight_l">
        <pose>0.752 0.28 0.24 0 0 0</pose>
        <geometry><box><size>0.004 0.10 0.05</size></box></geometry>
        <material><ambient>1 0.95 0.6 1</ambient><diffuse>1 0.95 0.6 1</diffuse><emissive>0.6 0.55 0.3 1</emissive></material>
      </visual>
      <visual name="headlight_r">
        <pose>0.752 -0.28 0.24 0 0 0</pose>
        <geometry><box><size>0.004 0.10 0.05</size></box></geometry>
        <material><ambient>1 0.95 0.6 1</ambient><diffuse>1 0.95 0.6 1</diffuse><emissive>0.6 0.55 0.3 1</emissive></material>
      </visual>
      <visual name="beacon">
        <pose>0.70 0.30 0.83 0 0 0</pose>
        <geometry><cylinder><radius>0.03</radius><length>0.06</length></cylinder></geometry>
        <material><ambient>1 0.5 0 1</ambient><diffuse>1 0.5 0 1</diffuse><emissive>0.5 0.25 0 1</emissive></material>
      </visual>

      <!-- 적재함: 바닥판 + 옆벽 + 뒷벽 + 칸 구분 레일 -->
      <visual name="bay_floor">
        <pose>-0.26 0 0.305 0 0 0</pose>
        <geometry><box><size>1.16 0.72 0.01</size></box></geometry>
        <material><ambient>0.95 0.55 0.1 1</ambient><diffuse>0.95 0.55 0.1 1</diffuse></material>
      </visual>
      <visual name="bay_wall_l">
        <pose>-0.26 0.36 0.43 0 0 0</pose>
        <geometry><box><size>1.18 0.02 0.25</size></box></geometry>
        <material><ambient>0.85 0.45 0.08 1</ambient><diffuse>0.85 0.45 0.08 1</diffuse></material>
      </visual>
      <visual name="bay_wall_r">
        <pose>-0.26 -0.36 0.43 0 0 0</pose>
        <geometry><box><size>1.18 0.02 0.25</size></box></geometry>
        <material><ambient>0.85 0.45 0.08 1</ambient><diffuse>0.85 0.45 0.08 1</diffuse></material>
      </visual>
      <visual name="bay_wall_rear">
        <pose>-0.84 0 0.43 0 0 0</pose>
        <geometry><box><size>0.02 0.74 0.25</size></box></geometry>
        <material><ambient>0.85 0.45 0.08 1</ambient><diffuse>0.85 0.45 0.08 1</diffuse></material>
      </visual>
      <visual name="slot_rail_1">
        <pose>-0.47 0 0.32 0 0 0</pose>
        <geometry><box><size>0.02 0.68 0.02</size></box></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <visual name="slot_rail_2">
        <pose>-0.25 0 0.32 0 0 0</pose>
        <geometry><box><size>0.02 0.68 0.02</size></box></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <visual name="slot_rail_3">
        <pose>-0.03 0 0.32 0 0 0</pose>
        <geometry><box><size>0.02 0.68 0.02</size></box></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <visual name="caster_front">
        <pose>0.62 0 0.04 0 0 0</pose>
        <geometry><sphere><radius>0.04</radius></sphere></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
      <visual name="caster_rear">
        <pose>-0.72 0 0.04 0 0 0</pose>
        <geometry><sphere><radius>0.04</radius></sphere></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
    </link>

    <!-- 라이다: 앞 범퍼 위, 낮게 (적재한 킥보드·팔이 스캔 평면에 안 걸리게) -->
    <link name="base_scan">
      <pose>0.80 0 0.22 0 0 0</pose>
      <inertial><mass>0.2</mass>
        <inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <!-- 몸통은 스캔 평면(센서 원점) 아래에 둔다: 센서가 자기 몸통 안에 있으면 모든 빔이 0.12 m(최소)로 막힌다 -->
      <visual name="lidar_visual">
        <pose>0 0 -0.035 0 0 0</pose>
        <geometry><cylinder><radius>0.04</radius><length>0.03</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <sensor name="hls_lfcd_lds" type="gpu_lidar">
        <gz_frame_id>base_scan</gz_frame_id>
        <topic>scan</topic>
        <update_rate>5</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <lidar>
          <scan><horizontal><samples>360</samples><resolution>1</resolution>
            <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
          <range><min>0.12</min><max>3.5</max><resolution>0.015</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
        </lidar>
      </sensor>
    </link>

    <link name="camera_link">
      <pose>0.76 0 0.45 0 0 0</pose>
      <inertial><mass>0.05</mass>
        <inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="camera_visual">
        <geometry><box><size>0.02 0.06 0.04</size></box></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
      <sensor name="camera" type="camera">
        <gz_frame_id>camera_optical_frame</gz_frame_id>
        <topic>camera/image_raw</topic>
        <!-- VM 성능 고려: 낮은 해상도/FPS. 필요하면 640x480 / 15Hz 로 올린다 -->
        <update_rate>5</update_rate>
        <always_on>true</always_on>
        <camera>
          <camera_info_topic>camera/camera_info</camera_info_topic>
          <horizontal_fov>1.085595</horizontal_fov>
          <image><width>320</width><height>240</height><format>R8G8B8</format></image>
          <clip><near>0.03</near><far>10</far></clip>
        </camera>
      </sensor>
    </link>

    <link name="wheel_left_link">
      <pose>0 0.41 0.10 -1.5708 0 0</pose>
      <inertial><mass>2.0</mass>
        <inertia><ixx>0.0058</ixx><iyy>0.0058</iyy><izz>0.01</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="c"><geometry><cylinder><radius>0.10</radius><length>0.07</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
      <visual name="v"><geometry><cylinder><radius>0.10</radius><length>0.07</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
      <visual name="hub"><pose>0 0 -0.036 0 0 0</pose><geometry><cylinder><radius>0.05</radius><length>0.004</length></cylinder></geometry>
        <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
    </link>
    <link name="wheel_right_link">
      <pose>0 -0.41 0.10 -1.5708 0 0</pose>
      <inertial><mass>2.0</mass>
        <inertia><ixx>0.0058</ixx><iyy>0.0058</iyy><izz>0.01</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="c"><geometry><cylinder><radius>0.10</radius><length>0.07</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
      <visual name="v"><geometry><cylinder><radius>0.10</radius><length>0.07</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
      <visual name="hub"><pose>0 0 0.036 0 0 0</pose><geometry><cylinder><radius>0.05</radius><length>0.004</length></cylinder></geometry>
        <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
    </link>

    <!-- ===================== 로봇팔 =====================
         관절이 모두 0 이면 팔이 +x 로 수평하게 뻗고 집게는 아래를 향한다.
         shoulder/elbow/wrist_pitch 는 +y 축 회전 (양수 = 아래로 숙임). -->
    <link name="arm_turret">
      <pose>0.50 0 0.80 0 0 0</pose>
      <inertial><pose>0 0 0.08 0 0 0</pose><mass>2.0</mass>
        <inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="base">
        <pose>0 0 0.04 0 0 0</pose>
        <geometry><cylinder><radius>0.11</radius><length>0.08</length></cylinder></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
      <visual name="post">
        <pose>0 0 0.10 0 0 0</pose>
        <geometry><cylinder><radius>0.06</radius><length>0.12</length></cylinder></geometry>
        <material><ambient>1 0.75 0.05 1</ambient><diffuse>1 0.75 0.05 1</diffuse></material>
      </visual>
      <visual name="shoulder_housing">
        <pose>0 0 0.15 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.065</radius><length>0.15</length></cylinder></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
    </link>
    <link name="upper_arm">
      <pose>0.50 0 0.95 0 0 0</pose>
      <inertial><pose>0.375 0 0 0 0 0</pose><mass>1.5</mass>
        <inertia><ixx>0.002</ixx><iyy>0.07</iyy><izz>0.07</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="v">
        <pose>0.375 0 0 0 0 0</pose>
        <geometry><box><size>0.75 0.08 0.08</size></box></geometry>
        <material><ambient>1 0.75 0.05 1</ambient><diffuse>1 0.75 0.05 1</diffuse></material>
      </visual>
      <visual name="elbow_housing">
        <pose>0.75 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.055</radius><length>0.12</length></cylinder></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
    </link>
    <link name="forearm">
      <pose>1.25 0 0.95 0 0 0</pose>
      <inertial><pose>0.375 0 0 0 0 0</pose><mass>1.0</mass>
        <inertia><ixx>0.001</ixx><iyy>0.047</iyy><izz>0.047</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="v">
        <pose>0.375 0 0 0 0 0</pose>
        <geometry><box><size>0.75 0.06 0.06</size></box></geometry>
        <material><ambient>1 0.75 0.05 1</ambient><diffuse>1 0.75 0.05 1</diffuse></material>
      </visual>
    </link>
    <link name="wrist">
      <pose>2.00 0 0.95 0 0 0</pose>
      <inertial><mass>0.3</mass>
        <inertia><ixx>0.0005</ixx><iyy>0.0005</iyy><izz>0.0005</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="joint">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.045</radius><length>0.09</length></cylinder></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
      <visual name="body">
        <pose>0 0 -0.05 0 0 0</pose>
        <geometry><cylinder><radius>0.035</radius><length>0.08</length></cylinder></geometry>
        <material><ambient>0.6 0.6 0.62 1</ambient><diffuse>0.6 0.6 0.62 1</diffuse></material>
      </visual>
    </link>
    <link name="gripper">
      <pose>2.00 0 0.95 0 0 0</pose>
      <inertial><pose>0 0 -0.12 0 0 0</pose><mass>0.3</mass>
        <inertia><ixx>0.002</ixx><iyy>0.0005</iyy><izz>0.002</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="palm">
        <pose>0 0 -0.12 0 0 0</pose>
        <geometry><box><size>0.08 0.30 0.04</size></box></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
    </link>
    <link name="finger_l">
      <pose>2.00 0.12 0.95 0 0 0</pose>
      <inertial><pose>0 0 -0.20 0 0 0</pose><mass>0.05</mass>
        <inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="v">
        <pose>0 0 -0.20 0 0 0</pose>
        <geometry><box><size>0.06 0.02 0.12</size></box></geometry>
        <material><ambient>0.85 0.1 0.1 1</ambient><diffuse>0.85 0.1 0.1 1</diffuse></material>
      </visual>
    </link>
    <link name="finger_r">
      <pose>2.00 -0.12 0.95 0 0 0</pose>
      <inertial><pose>0 0 -0.20 0 0 0</pose><mass>0.05</mass>
        <inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="v">
        <pose>0 0 -0.20 0 0 0</pose>
        <geometry><box><size>0.06 0.02 0.12</size></box></geometry>
        <material><ambient>0.85 0.1 0.1 1</ambient><diffuse>0.85 0.1 0.1 1</diffuse></material>
      </visual>
    </link>

    <joint name="scan_joint" type="fixed"><parent>base_link</parent><child>base_scan</child></joint>
    <joint name="camera_joint" type="fixed"><parent>base_link</parent><child>camera_link</child></joint>
    <joint name="wheel_left_joint" type="revolute">
      <parent>base_link</parent><child>wheel_left_link</child>
      <axis><xyz>0 0 1</xyz></axis>
    </joint>
    <joint name="wheel_right_joint" type="revolute">
      <parent>base_link</parent><child>wheel_right_link</child>
      <axis><xyz>0 0 1</xyz></axis>
    </joint>

    <joint name="arm_yaw" type="revolute">
      <parent>base_link</parent><child>arm_turret</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-7</lower><upper>7</upper></limit></axis>
    </joint>
    <joint name="arm_shoulder" type="revolute">
      <parent>arm_turret</parent><child>upper_arm</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-3.1</lower><upper>3.1</upper></limit></axis>
    </joint>
    <joint name="arm_elbow" type="revolute">
      <parent>upper_arm</parent><child>forearm</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-3.1</lower><upper>3.1</upper></limit></axis>
    </joint>
    <joint name="arm_wrist_pitch" type="revolute">
      <parent>forearm</parent><child>wrist</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-3.1</lower><upper>3.1</upper></limit></axis>
    </joint>
    <joint name="arm_wrist_rot" type="revolute">
      <parent>wrist</parent><child>gripper</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-7</lower><upper>7</upper></limit></axis>
    </joint>
    <!-- 집게: 둘 다 음수로 갈수록 닫힘 (0 = 완전히 벌림, 손가락 안쪽 간격 0.22 m) -->
    <joint name="arm_finger_l" type="prismatic">
      <parent>gripper</parent><child>finger_l</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-0.11</lower><upper>0</upper></limit></axis>
    </joint>
    <joint name="arm_finger_r" type="prismatic">
      <parent>gripper</parent><child>finger_r</child>
      <axis><xyz>0 -1 0</xyz><limit><lower>-0.11</lower><upper>0</upper></limit></axis>
    </joint>

    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>0.82</wheel_separation>
      <wheel_radius>0.10</wheel_radius>
      <max_linear_velocity>0.26</max_linear_velocity>
      <max_angular_velocity>1.0</max_angular_velocity>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
    <!-- 로봇 world pose (정답값) -> /model/kickboard_robot/pose -> 브리지 -> ROS /sim/robot_pose.
         arm_loader 가 적재함 킥보드를 로봇에 붙여 움직일 때 쓴다 (odom 은 미끄러지면 어긋나므로) -->
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_model_pose>true</publish_model_pose>
      <publish_link_pose>false</publish_link_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <use_pose_vector_msg>false</use_pose_vector_msg>
      <update_frequency>30</update_frequency>
    </plugin>

    <!-- 팔 관절 위치 제어: 속도 명령 모드 (중력·반력에 흔들리지 않고 명령 위치를 바로 따라감).
         명령 토픽 /kickboard_robot/arm/<관절> (gz.msgs.Double) — arm_loader 가 gz transport 로 직접 보낸다.
         initial_position = 접은 자세: 적재함 쪽을 보고 높이 접음 (arm_loader.HOME 과 같게) -->
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>arm_yaw</joint_name><topic>/kickboard_robot/arm/arm_yaw</topic>
      <use_velocity_commands>true</use_velocity_commands><p_gain>8</p_gain>
      <cmd_max>2.5</cmd_max><cmd_min>-2.5</cmd_min><initial_position>3.1416</initial_position>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>arm_shoulder</joint_name><topic>/kickboard_robot/arm/arm_shoulder</topic>
      <use_velocity_commands>true</use_velocity_commands><p_gain>8</p_gain>
      <cmd_max>2.5</cmd_max><cmd_min>-2.5</cmd_min><initial_position>-1.9809</initial_position>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>arm_elbow</joint_name><topic>/kickboard_robot/arm/arm_elbow</topic>
      <use_velocity_commands>true</use_velocity_commands><p_gain>8</p_gain>
      <cmd_max>2.5</cmd_max><cmd_min>-2.5</cmd_min><initial_position>2.0314</initial_position>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>arm_wrist_pitch</joint_name><topic>/kickboard_robot/arm/arm_wrist_pitch</topic>
      <use_velocity_commands>true</use_velocity_commands><p_gain>8</p_gain>
      <cmd_max>2.5</cmd_max><cmd_min>-2.5</cmd_min><initial_position>-0.0504</initial_position>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>arm_wrist_rot</joint_name><topic>/kickboard_robot/arm/arm_wrist_rot</topic>
      <use_velocity_commands>true</use_velocity_commands><p_gain>8</p_gain>
      <cmd_max>2.5</cmd_max><cmd_min>-2.5</cmd_min><initial_position>0.0</initial_position>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>arm_finger_l</joint_name><topic>/kickboard_robot/arm/arm_finger_l</topic>
      <use_velocity_commands>true</use_velocity_commands><p_gain>8</p_gain>
      <cmd_max>0.3</cmd_max><cmd_min>-0.3</cmd_min><initial_position>0.0</initial_position>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>arm_finger_r</joint_name><topic>/kickboard_robot/arm/arm_finger_r</topic>
      <use_velocity_commands>true</use_velocity_commands><p_gain>8</p_gain>
      <cmd_max>0.3</cmd_max><cmd_min>-0.3</cmd_min><initial_position>0.0</initial_position>
    </plugin>
  </model>
</sdf>
