<?xml version="1.0"?>
<!-- 충전소. 모델 원점 = 바닥 중심, 태그 면 = +x 쪽 (x = 0.15).
     TODO(A): 패널에 tag36h11 id 100 텍스처를 입히면 apriltag_ros 로 실제 검출 가능 -->
<sdf version="1.9">
  <model name="charging_station">
    <static>true</static>
    <link name="body">
      <collision name="c"><pose>0 0 0.25 0 0 0</pose><geometry><box><size>0.3 0.6 0.5</size></box></geometry></collision>
      <visual name="v"><pose>0 0 0.25 0 0 0</pose><geometry><box><size>0.3 0.6 0.5</size></box></geometry>
        <material><ambient>0.1 0.3 0.8 1</ambient><diffuse>0.1 0.3 0.8 1</diffuse></material></visual>
      <visual name="tag"><pose>0.152 0 0.25 0 0 0</pose><geometry><box><size>0.004 0.24 0.24</size></box></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
      <visual name="pad"><pose>1.15 0 0.002 0 0 0</pose><geometry><box><size>1.85 1.0 0.004</size></box></geometry>
        <material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material></visual>
    </link>
  </model>
</sdf>
