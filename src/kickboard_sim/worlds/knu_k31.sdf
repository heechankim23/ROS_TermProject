<?xml version="1.0"?>
<!-- 시나리오 k31 전용 작은 캠퍼스 (864 x 756 m). scripts/build_scenario_worlds.py 가 만든 파일.
     좌표는 캠퍼스 전체 world 와 같다. 바닥 충돌은 평면, 건물·거치대는 이 범위 안의 것만. 맵 설정: config/maps/knu_k31.yaml -->
<sdf version="1.9">
  <world name="knu_k31">
    <physics name="default" type="ignored">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>
    <scene>
      <ambient>0.65 0.65 0.65 1</ambient>
      <background>0.70 0.80 0.92 1</background>
      <grid>false</grid>
    </scene>
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 300 0 0 0</pose>
      <diffuse>0.9 0.9 0.88 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.3 -0.85</direction>
    </light>
    <model name="terrain">
      <static>true</static>
      <link name="link">
        <collision name="c"><pose>-64.0 -118.0 0 0 0 0</pose><geometry><plane><normal>0 0 1</normal><size>904 796</size></plane></geometry></collision>
        <visual name="v"><pose>0 0 0.005 0 0 0</pose><geometry><mesh><uri>model://knu_campus/meshes/terrain_k31.obj</uri></mesh></geometry></visual>
      </link>
    </model>
    <model name="buildings">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><mesh><uri>model://knu_campus/meshes/buildings_k31.obj</uri></mesh></geometry></collision>
        <visual name="v"><geometry><mesh><uri>model://knu_campus/meshes/buildings_k31.obj</uri></mesh></geometry></visual>
      </link>
    </model>
    <model name="kickboard_racks">
      <static>true</static>
      <link name="link">
        <visual name="v"><geometry><mesh><uri>model://knu_campus/meshes/racks_k31.obj</uri></mesh></geometry></visual>
        <collision name="C1_rack"><pose>200.695 134.714 0.4 0 0 1.5095</pose><geometry><box><size>7.00 0.3 0.8</size></box></geometry></collision>
        <collision name="C3_rack"><pose>238.996 -115.277 0.4 0 0 -3.0508</pose><geometry><box><size>7.00 0.3 0.8</size></box></geometry></collision>
        <collision name="C4_rack"><pose>95.508 218.293 0.4 0 0 -0.0191</pose><geometry><box><size>7.00 0.3 0.8</size></box></geometry></collision>
        <collision name="C5_rack"><pose>-10.352 109.027 0.4 0 0 -2.7986</pose><geometry><box><size>7.00 0.3 0.8</size></box></geometry></collision>
        <collision name="C6_rack"><pose>-163.884 -400.465 0.4 0 0 3.1187</pose><geometry><box><size>7.00 0.3 0.8</size></box></geometry></collision>
        <collision name="C7_rack"><pose>-33.437 -173.756 0.4 0 0 -0.1313</pose><geometry><box><size>7.00 0.3 0.8</size></box></geometry></collision>
        <collision name="C8_rack"><pose>-268.283 -256.271 0.4 0 0 1.6936</pose><geometry><box><size>7.00 0.3 0.8</size></box></geometry></collision>
        <collision name="P05_rack"><pose>-81.450 192.094 0.4 0 0 -2.8691</pose><geometry><box><size>7.20 0.3 0.8</size></box></geometry></collision>
        <collision name="P07_rack"><pose>-101.049 161.934 0.4 0 0 -1.8339</pose><geometry><box><size>7.20 0.3 0.8</size></box></geometry></collision>
        <collision name="P08_rack"><pose>262.508 127.872 0.4 0 0 -1.5623</pose><geometry><box><size>7.20 0.3 0.8</size></box></geometry></collision>
        <collision name="P09_rack"><pose>-136.725 97.547 0.4 0 0 2.8962</pose><geometry><box><size>7.20 0.3 0.8</size></box></geometry></collision>
        <collision name="P11_rack"><pose>326.677 57.348 0.4 0 0 2.6915</pose><geometry><box><size>7.20 0.3 0.8</size></box></geometry></collision>
        <collision name="P13_rack"><pose>-68.094 -10.548 0.4 0 0 -0.2554</pose><geometry><box><size>7.20 0.3 0.8</size></box></geometry></collision>
        <collision name="P16_rack"><pose>-297.616 -64.201 0.4 0 0 1.5574</pose><geometry><box><size>7.20 0.3 0.8</size></box></geometry></collision>
        <collision name="P19_rack"><pose>-226.817 -126.886 0.4 0 0 0.2226</pose><geometry><box><size>7.20 0.3 0.8</size></box></geometry></collision>
        <collision name="P23_rack"><pose>-58.741 -270.218 0.4 0 0 -0.0526</pose><geometry><box><size>7.20 0.3 0.8</size></box></geometry></collision>
        <collision name="P24_rack"><pose>-144.245 -240.731 0.4 0 0 3.1190</pose><geometry><box><size>7.20 0.3 0.8</size></box></geometry></collision>
        <collision name="P27_rack"><pose>-453.251 -349.529 0.4 0 0 -0.0210</pose><geometry><box><size>7.20 0.3 0.8</size></box></geometry></collision>
        <collision name="P28_rack"><pose>-392.001 -354.255 0.4 0 0 -0.1338</pose><geometry><box><size>7.20 0.3 0.8</size></box></geometry></collision>
        <collision name="P29_rack"><pose>135.089 -380.739 0.4 0 0 2.8859</pose><geometry><box><size>7.20 0.3 0.8</size></box></geometry></collision>
        <collision name="P30_rack"><pose>57.378 -418.487 0.4 0 0 3.1051</pose><geometry><box><size>7.20 0.3 0.8</size></box></geometry></collision>
        <collision name="P31_rack"><pose>-131.093 -457.962 0.4 0 0 -0.0221</pose><geometry><box><size>7.20 0.3 0.8</size></box></geometry></collision>
      </link>
    </model>
    <include>
      <uri>model://charging_station</uri>
      <name>charging_station</name>
      <pose>-90.297 -182.187 0 0 0 -0.2132</pose>
    </include>
  </world>
</sdf>
