<?xml version="1.0"?>
<!-- 시나리오 k03 전용 작은 캠퍼스 (276 x 216 m). scripts/build_scenario_worlds.py 가 만든 파일.
     좌표는 캠퍼스 전체 world 와 같다. 바닥 충돌은 평면, 건물·거치대는 이 범위 안의 것만. 맵 설정: config/maps/knu_k03.yaml -->
<sdf version="1.9">
  <world name="knu_k03">
    <physics name="default" type="ignored">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>
    <scene>
      <ambient>0.65 0.65 0.65 1</ambient>
      <background>0.70 0.80 0.92 1</background>
      <grid>false</grid>
    </scene>
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 300 0 0 0</pose>
      <diffuse>0.9 0.9 0.88 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.3 -0.85</direction>
    </light>
    <model name="terrain">
      <static>true</static>
      <link name="link">
        <collision name="c"><pose>18.0 236.0 0 0 0 0</pose><geometry><plane><normal>0 0 1</normal><size>316 256</size></plane></geometry></collision>
        <visual name="v"><pose>0 0 0.005 0 0 0</pose><geometry><mesh><uri>model://knu_campus/meshes/terrain_k03.obj</uri></mesh></geometry></visual>
      </link>
    </model>
    <model name="buildings">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><mesh><uri>model://knu_campus/meshes/buildings_k03.obj</uri></mesh></geometry></collision>
        <visual name="v"><geometry><mesh><uri>model://knu_campus/meshes/buildings_k03.obj</uri></mesh></geometry></visual>
      </link>
    </model>
    <model name="kickboard_racks">
      <static>true</static>
      <link name="link">
        <visual name="v"><geometry><mesh><uri>model://knu_campus/meshes/racks_k03.obj</uri></mesh></geometry></visual>
        <collision name="P02_rack"><pose>115.967 303.376 0.4 0 0 -0.0326</pose><geometry><box><size>7.20 0.3 0.8</size></box></geometry></collision>
        <collision name="P05_rack"><pose>-81.450 192.094 0.4 0 0 -2.8691</pose><geometry><box><size>7.20 0.3 0.8</size></box></geometry></collision>
      </link>
    </model>

    <!-- 로봇 충전소 차고 (Blender). 문이 길 쪽, 로봇은 안에서 충전 -->
    <include>
      <uri>model://scootover_robot_station</uri>
      <name>charging_station</name>
      <pose>67.063 219.082 0 0 0 -1.5909</pose>
    </include>
  </world>
</sdf>
