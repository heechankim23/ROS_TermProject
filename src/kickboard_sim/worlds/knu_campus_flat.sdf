<?xml version="1.0"?>
<!-- 경북대학교 대구캠퍼스 (평지). scripts/build_knu_campus.py 가 만든 파일 — 직접 고치지 말고 스크립트를 고칠 것.
     world 프레임 = map 프레임 (+x 동, +y 북, 원점 위도 35.8904 경도 128.6103). 맵 설정: config/maps/knu_campus.yaml
     지형 z 는 로봇 도크(차고 옆) = 0. 주차구역 31곳, 충전 주차구역 5곳.
     킥보드는 scooter_fleet_sim 이 시나리오대로 만든다. -->
<sdf version="1.9">
  <world name="knu_campus_flat">
    <physics name="default" type="ignored">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>35.8904</latitude_deg>
      <longitude_deg>128.6103</longitude_deg>
      <elevation>58.8</elevation>
    </spherical_coordinates>
    <scene>
      <ambient>0.65 0.65 0.65 1</ambient>
      <background>0.70 0.80 0.92 1</background>
      <grid>false</grid>
    </scene>
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 300 0 0 0</pose>
      <diffuse>0.9 0.9 0.88 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.3 -0.85</direction>
    </light>
    <!-- 지형: SRTM 고도 평활화 + 바닥 그림(도로·보행로·잔디·운동장·일청담·등고선·주차/충전 칸) -->
    <model name="terrain">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><mesh><uri>model://knu_campus/meshes/terrain_flat.obj</uri></mesh></geometry></collision>
        <visual name="v"><geometry><mesh><uri>model://knu_campus/meshes/terrain_flat.obj</uri></mesh></geometry></visual>
      </link>
    </model>
    <!-- 건물 94동 (OSM 외곽선 + 높이, 안내도 5개 구역 색) -->
    <model name="buildings">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><mesh><uri>model://knu_campus/meshes/buildings_flat.obj</uri></mesh></geometry></collision>
        <visual name="v"><geometry><mesh><uri>model://knu_campus/meshes/buildings_flat.obj</uri></mesh></geometry></visual>
      </link>
    </model>
    <!-- 출입문 기둥 (일반 주차구역에는 거치대 없음 — 바닥 그림만) -->
    <model name="kickboard_racks">
      <static>true</static>
      <link name="link">
        <visual name="v"><geometry><mesh><uri>model://knu_campus/meshes/racks_flat.obj</uri></mesh></geometry></visual>
      </link>
    </model>
    <!-- 킥보드 충전구역: Kickspot 4구 x 2 (Blender) -->
    <include><uri>model://kickspot_4</uri><name>C2_kickspot_1</name><pose>371.752 -174.527 0.000 0 0 0.6034</pose></include>
    <include><uri>model://kickspot_4</uri><name>C2_kickspot_2</name><pose>373.511 -177.079 0.000 0 0 0.6034</pose></include>
    <include><uri>model://kickspot_4</uri><name>C4_kickspot_1</name><pose>93.950 217.902 0.000 0 0 -1.5899</pose></include>
    <include><uri>model://kickspot_4</uri><name>C4_kickspot_2</name><pose>97.050 217.843 0.000 0 0 -1.5899</pose></include>
    <include><uri>model://kickspot_4</uri><name>C5_kickspot_1</name><pose>-9.034 109.944 0.000 0 0 1.9138</pose></include>
    <include><uri>model://kickspot_4</uri><name>C5_kickspot_2</name><pose>-11.953 108.901 0.000 0 0 1.9138</pose></include>
    <include><uri>model://kickspot_4</uri><name>C7_kickspot_1</name><pose>-34.918 -173.137 0.000 0 0 1.4395</pose></include>
    <include><uri>model://kickspot_4</uri><name>C7_kickspot_2</name><pose>-31.845 -173.543 0.000 0 0 1.4395</pose></include>
    <include><uri>model://kickspot_4</uri><name>C8_kickspot_1</name><pose>-268.510 -257.860 0.000 0 0 -3.0188</pose></include>
    <include><uri>model://kickspot_4</uri><name>C8_kickspot_2</name><pose>-268.890 -254.784 0.000 0 0 -3.0188</pose></include>
    <!-- 로봇 충전소 차고 (100 본관 옆, Blender). 문이 길 쪽, 로봇은 안에서 충전 -->
    <include>
      <uri>model://scootover_robot_station</uri>
      <name>charging_station</name>
      <pose>179.629 44.553 0.000 0 0 1.0694</pose>
    </include>
  </world>
</sdf>
