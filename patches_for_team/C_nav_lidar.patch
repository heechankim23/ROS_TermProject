+def nearest_free(cm, target, clearance, t, min_dist=0.0, max_dist=6.0, keep_clearance=None):
+    """target 에서 가장 가까운 '빈 자리'(장애물과 clearance 이상) -> (x, y, target 을 보는 yaw) 또는 None.
